# Copy to .env for `docker compose up`
ANTHROPIC_API_KEY=
GITHUB_TOKEN=                 # repo scope (or fine-grained: pull requests rw, contents r)
GITHUB_WEBHOOK_SECRET=        # same value as in the GitHub webhook settings
ALLOW_UNSIGNED_WEBHOOKS=false # true only for local experiments without a secret
LLM_BACKEND=fake              # "anthropic" (with ANTHROPIC_API_KEY) for real Claude reviews
GRAPHIFY_ENABLED=true         # false → built-in Python AST graph instead of `graphify extract`
AGENT_MODEL=claude-opus-5-5
CRITIC_MODEL=claude-opus-5-5
